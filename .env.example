# ruprogress-mcp environment configuration.
# See docs/configuration.md for the full variable reference and which of these
# the server validates today.

REDMINE_URL=https://your-redmine-server.com

# Log verbosity: an EnvFilter directive string, also settable via --log-level
# (which wins if both are set). A payload-safety floor is always applied on
# top of this (rmcp, hyper, reqwest, and friends capped at info/debug even
# under "trace") so a tool call's arguments never reach the log; name a
# floored target explicitly (e.g. "trace,rmcp=trace") to lift it for that
# target, which also logs a startup WARN. See docs/configuration.md#logging.
# RUST_LOG=info

# Log line format: "text" (default) or "json" (one JSON object per line, for
# a log aggregator) — cosmetic only, does not change what is logged. See
# docs/configuration.md#observability.
# REDMINE_MCP_LOG_FORMAT=text

# Authentication mode: "legacy" (default), "legacy-per-user", "oauth", or
# "oauth-proxy".
# REDMINE_AUTH_MODE=legacy

# legacy mode: the API key sent as X-Redmine-API-Key.
REDMINE_API_KEY=your_api_key
# Or point at a file instead (Docker/K8s secret mount); setting both is an error.
# REDMINE_API_KEY_FILE=/run/secrets/redmine_api_key

# SSL certificate verification (default: true). Only disable for dev/test.
# REDMINE_SSL_VERIFY=true

# Read-only mode: blocks write tools when true (none exist yet).
# REDMINE_MCP_READ_ONLY=false

# JSON Schema dialect served in tools/list's inputSchema: "strict" (default,
# full JSON Schema 2020-12 with $ref/$defs and nullable unions) or "portable"
# (a lossy OpenAPI-3.0-subset form with $ref/$defs inlined and nullable type
# arrays collapsed) for Google Vertex/Gemini clients, whose function-calling
# schema validator rejects the strict form. outputSchema is unaffected.
# REDMINE_MCP_SCHEMA_DIALECT=strict

# --- HTTP transport (--transport http only; ignored over stdio) ---
#
# The default bind is loopback-only. To expose the server on a network you
# MUST uncomment SERVER_HOST and PUBLIC_HOST *together* — a non-loopback
# SERVER_HOST with no Host policy is a startup error, because an empty Host
# allowlist means "allow every host" and DNS rebinding is same-origin, so
# Host is the only signal left. See docs/configuration.md.
#
# SERVER_HOST=0.0.0.0
# PUBLIC_HOST=mcp.example.com
# PUBLIC_PORT=8000
# SERVER_PORT=8000
#
# Scheme used to build /files/{uuid} attachment URLs (get_redmine_attachment).
# Defaults to "https" only when PUBLIC_PORT is 443, "http" otherwise.
# PUBLIC_SCHEME=https
#
# Path the MCP endpoint is served on.
# FASTMCP_STREAMABLE_HTTP_PATH=/mcp
#
# Overrides the derived Host allowlist entirely. "*" disables Host validation
# and logs a WARN — only behind a proxy that validates Host itself.
# REDMINE_MCP_ALLOWED_HOSTS=mcp.example.com,mcp.internal:8000
#
# Browser origins allowed to call this server. Empty means no CORS headers at
# all; "*" is rejected. Each entry needs a scheme.
# REDMINE_MCP_ALLOWED_ORIGINS=https://app.example.com
#
# Request body cap, 1 KiB .. 64 MiB. Oversized payloads get a 413.
# REDMINE_MCP_MAX_REQUEST_BODY_BYTES=4194304
#
# How long a /readyz Redmine probe stays cached, 0..3600 (0 disables caching).
# HEALTH_INTROSPECTION_TTL_SECONDS=30
#
# Rate limiting: on by default. Standard class (/mcp, /files/{uuid}) keys by
# bearer-token digest when present, else peer IP; strict class (/register,
# /authorize, /auth/callback, /token, /revoke) always keys by peer IP only.
# Never applies behind a reverse proxy sharing one egress IP without proxy-side
# limiting of its own — see docs/troubleshooting.md.
# REDMINE_MCP_RATE_LIMIT_ENABLED=true
# REDMINE_MCP_RATE_LIMIT_RPS=10
# REDMINE_MCP_RATE_LIMIT_BURST=40
# REDMINE_MCP_RATE_LIMIT_AUTH_RPS=1
# REDMINE_MCP_RATE_LIMIT_AUTH_BURST=10
# REDMINE_MCP_RATE_LIMIT_MAX_KEYS=10000

# RedmineUP / plugin-gated tool families (all default false; surfaced via
# get_mcp_server_info's plugin_flags). REDMINE_CHECKLISTS_ENABLED registers
# get_checklist/create_checklist_item/update_checklist_item; REDMINE_PRODUCTS_ENABLED
# registers manage_product; REDMINE_CRM_ENABLED registers manage_contact;
# REDMINE_DMSF_ENABLED registers manage_document (redmine_dmsf plugin);
# REDMINE_AGILE_ENABLED adds no new tools but lets get_redmine_issue/
# update_redmine_issue read and write story_points/agile_sprint_id/
# agile_position; REDMINE_TAGS_ENABLED likewise adds no new tools but lets
# get_redmine_issue report an issue's tags and create_redmine_issue/
# update_redmine_issue replace them via tag_list.
# REDMINE_AGILE_ENABLED=false
# REDMINE_CHECKLISTS_ENABLED=false
# REDMINE_PRODUCTS_ENABLED=false
# REDMINE_CRM_ENABLED=false
# REDMINE_DMSF_ENABLED=false
# REDMINE_TAGS_ENABLED=false

# Required-custom-field autofill on create_redmine_issue/update_redmine_issue:
# on a 422 naming a required issue custom field as blank or invalid, retry
# the write exactly once with a value filled from the field's own
# default_value or from the map below, reported as autofilled_custom_fields.
# Off by default; the 422 is still enriched with missing_required_fields.
# REDMINE_AUTOFILL_REQUIRED_CUSTOM_FIELDS=false
#
# JSON object mapping a custom field's display name to a default value (a
# string, or an array of strings for a multiple=true field). Only used when
# the field has no default_value of its own and autofill is enabled above.
# Invalid JSON, a non-object, or a non-string/array value fails the boot.
# REDMINE_REQUIRED_CUSTOM_FIELD_DEFAULTS={"Department": "Engineering"}

# --- legacy-per-user auth (advanced; requires --transport http) ---
# Each request supplies its own X-Redmine-API-Key header instead of a single
# shared key. See docs/legacy-per-user-auth.md before enabling this in
# production: REDMINE_PER_USER_TRUST_PROXY is an attestation this server
# cannot verify.
# REDMINE_AUTH_MODE=legacy-per-user
# REDMINE_PER_USER_TRUST_PROXY=true
# REDMINE_PER_USER_AUDIT_IDENTITY=false

# --- oauth mode (advanced; requires --transport http) ---
# Each request supplies its own Authorization: Bearer token, validated by RFC
# 7662 introspection against Redmine's Doorkeeper, then checked against a
# per-tool scope map before tools/list or tools/call proceed. See
# docs/oauth-setup.md.
# REDMINE_AUTH_MODE=oauth
# REDMINE_MCP_BASE_URL=http://localhost:3040
# REDMINE_INTROSPECT_CLIENT_ID=your-doorkeeper-application-uid
# REDMINE_INTROSPECT_CLIENT_SECRET=your-doorkeeper-application-secret
# REDMINE_OAUTH_TOKEN_CACHE_TTL_SECONDS=60
#
# Serve the RFC 8414 authorization-server document at the root well-known
# path (issuer = REDMINE_MCP_BASE_URL) instead of the /mcp-suffixed default
# (issuer = REDMINE_URL). Only needed for clients (e.g. Cursor) that probe
# the canonical root location.
# REDMINE_OAUTH_DISCOVERY_AS=redmine
#
# Narrow the advertised scopes_supported to a subset (whitespace-separated)
# of what this server would otherwise advertise, e.g. when the Redmine OAuth
# Application only grants a subset of permissions.
# REDMINE_MCP_SCOPES=view_project view_issues add_issues edit_issues
#
# Disable tools/list filtering and tools/call scope denial, restoring
# unfiltered behaviour. Only for tokens minted before the OAuth application
# advertised scopes; logs a startup WARN.
# REDMINE_OAUTH_SCOPE_ENFORCEMENT=on

# --- oauth-proxy mode (advanced; requires --transport http) ---
# This server is itself an authorization server: MCP clients discover it,
# register via RFC 7591 DCR (POST /register), and run authorization-code +
# PKCE against /authorize and /token, which drive a second, independent
# authorization-code flow against Redmine on their behalf. See
# docs/oauth-setup.md.
# REDMINE_AUTH_MODE=oauth-proxy
# REDMINE_MCP_BASE_URL=http://localhost:3040
# REDMINE_INTROSPECT_CLIENT_ID=your-doorkeeper-application-uid
# REDMINE_INTROSPECT_CLIENT_SECRET=your-doorkeeper-application-secret
#
# The upstream OAuth application this server will authenticate itself to
# Redmine's authorization-code flow with. Defaults to the introspection
# client above when both are left unset; setting one without the other is a
# startup error. Enable use_refresh_token on this application so a session
# survives the upstream access token's expiry without a browser.
# REDMINE_OAUTH_CLIENT_ID=your-upstream-application-uid
# REDMINE_OAUTH_CLIENT_SECRET=your-upstream-application-secret
#
# Which redirect URIs a DCR client may register: comma/whitespace-separated
# scheme://host[:port]/path* patterns, or "*" for no restriction beyond
# http(s)-only (logs a startup WARN). Defaults to loopback only
# (http://localhost:*, http://127.0.0.1:*) — right for CLI/desktop clients.
# REDMINE_MCP_ALLOWED_CLIENT_REDIRECT_URIS=https://your-hosted-client.example.com/callback

# --- Attachment store (used by get_redmine_attachment, upload_file,
# list_files, delete_file) ---
#
# Where downloaded attachments are staged, created 0700 on startup.
# Defaults to {temp_dir}/ruprogress-mcp-attachments.
# ATTACHMENTS_DIR=/var/lib/ruprogress-mcp/attachments
#
# Per-file and whole-store byte caps. The store cap must be >= the per-file
# cap, or no single download could ever fit.
# ATTACHMENT_MAX_DOWNLOAD_BYTES=209715200
# ATTACHMENT_STORE_MAX_BYTES=2147483648
#
# Background sweeper that reclaims expired files.
# AUTO_CLEANUP_ENABLED=true
# CLEANUP_INTERVAL_MINUTES=15
# ATTACHMENT_EXPIRES_MINUTES=60
#
# Absolute directory roots upload_file's file_path source is allowed to read
# from, in addition to ATTACHMENTS_DIR itself. Empty means only ATTACHMENTS_DIR
# is allowed.
# REDMINE_MCP_UPLOAD_FILE_ROOTS=/srv/uploads
#
# Registers cleanup_attachment_files (admin-only).
# REDMINE_MCP_EXPOSE_ADMIN_TOOLS=false
#
# Rewrites content_url values whose origin matches REDMINE_URL's, for a
# reverse-proxied Redmine.
# REDMINE_PUBLIC_URL=https://redmine.example.com
